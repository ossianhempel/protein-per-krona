{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protein-per-krona",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
